{
  "version": 2,
  "builds": [
    {
      "src": "api/index.py",
      "use": "@vercel/python"
    }
  ],
  "routes": [
    {
      "src": "/static/(.*)",
      "dest": "/staticfiles/$1"
    },
    {
      "src": "/(.*)",
      "dest": "api/index.py"
    }
  ],
  "functions": {
    "api/index.py": {
      "includeFiles": [
        "staticfiles/**",
        "EShop/**",
        "Store/**",
        "db.sqlite3"
      ]
    }
  },
  "installCommand": "pip install -r requirements.txt",
  "buildCommand": "python EShop/manage.py migrate && python EShop/manage.py collectstatic --noinput"
}
