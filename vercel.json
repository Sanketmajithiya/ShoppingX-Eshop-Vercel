{
  "version": 2,
  "functions": {
    "api/index.py": {
      "runtime": "python3.9",
      "includeFiles": "staticfiles/** EShop/** Store/** db.sqlite3"
    }
  },
  "routes": [
    {
      "src": "/static/(.*)",
      "dest": "/staticfiles/$1"
    },
    {
      "src": "/(.*)",
      "dest": "api/index.py"
    }
  ]
}
