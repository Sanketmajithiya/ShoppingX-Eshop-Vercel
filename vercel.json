{
    "builds": [
        {
            "src": "EShop/EShop/wsgi.py",
            "use": "@vercel/python",
            "config": {
                "maxLambdaSize": "15mb",
                "runtime": "python3.12.4"
            }
        }
    ],
    "routes": [
        {
            "src": "EShop/(.*)",
            "dest": "EShop/EShop/wsgi.py"
        }
    ]
}