{
  "builds": [
    {
      "src": "EShop/wsgi.py",
      "use": "@vercel/python"
    }
  ],
  "routes": [
    {
      "src": "/static/(.*)",
      "dest": "/staticfiles/$1"
    },
    {
      "src": "/(.*)",
      "dest": "EShop/wsgi.py"
    }
  ],
  "functions": {
    "EShop/wsgi.py": {
      "includeFiles": "staticfiles/**"
    }
  },
  "installCommand": "pip install -r requirements.txt",
  "buildCommand": "python EShop/manage.py collectstatic --noinput"
}
