{
  "version": 2,
  "functions": {
    "api/index.py": {
      "includeFiles": "staticfiles/** EShop/** Store/** db.sqlite3"
    }
  },
  "routes": [
    {
      "src": "/static/(.*)",
      "dest": "/staticfiles/$1"
    },
    {
      "src": "/(.*)",
      "dest": "api/index.py"
    }
  ],
  "installCommand": "pip install -r requirements.txt",
  "buildCommand": "python EShop/manage.py migrate && python EShop/manage.py collectstatic --noinput"
}
